# LLM Cost Proxy Configuration
HOST=0.0.0.0
PORT=8080

# Rate Limiting Presets: strict (20 RPM / 20k TPM), standard (60 RPM / 100k TPM), relaxed (120 RPM / 500k TPM)
RATE_LIMIT_PRESET=standard

# Budget Cap in USD (0 for unlimited)
BUDGET_CAP_USD=100.0

# Default model when unspecified
DEFAULT_MODEL=gpt-4o
